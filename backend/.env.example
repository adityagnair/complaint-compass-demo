# Copy this file to backend/.env and paste the PostgreSQL URI from Supabase > Connect.
# Keep the password private. SSL is enforced by the backend's connection setup.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres?sslmode=require
DEMO_MODE=false
WORKSPACE_AUTH_ENABLED=false
WORKSPACE_ACCESS_TOKEN=replace-with-a-long-random-secret

# If DATABASE_URL is unset, the app uses this local SQLite file instead.
COMPLAINT_COMPASS_DB=data/complaint_compass.db

# Add the deployed Vercel origin when configuring Render.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NLP and local issue naming
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_HOME=data/model-cache
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_LABELS=true
OLLAMA_TIMEOUT_SECONDS=180

# Set a long random value before configuring channel providers to use the
# authenticated JSON webhooks at /api/intake/{email,voice,chatbot,social}.
INTAKE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
